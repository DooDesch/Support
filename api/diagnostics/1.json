{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "string",
      "const": "mmorpgtycoon2-multiplayer"
    },
    "report_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "diagnostic_session": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "client_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "manual",
        "error",
        "interrupted",
        "session"
      ]
    },
    "consent": {
      "type": "boolean",
      "const": true
    },
    "comment": {
      "type": "string",
      "maxLength": 2000
    },
    "build": {
      "type": "object",
      "properties": {
        "multiplayer": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.]+)?$"
        },
        "hashes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "game",
              "framework",
              "loader",
              "multiplayer",
              "steam"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "mods": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:/ -]{1,120}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:/ -]{1,120}$"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "multiplayer",
        "hashes",
        "mods"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "string",
      "enum": [
        "none",
        "host",
        "client"
      ]
    },
    "peer_slot": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dropped_events": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/ -]{1,120}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{0,100}$"
          },
          "line": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "cause": {
            "type": "string",
            "maxLength": 768
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "action_sequence",
                "revision",
                "peer_slot",
                "required_mask",
                "ack_mask",
                "channel",
                "bytes",
                "duration_us",
                "count",
                "frame_us"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "action_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          }
        },
        "required": [
          "ms",
          "level",
          "code",
          "source",
          "line",
          "cause",
          "values",
          "action_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "product",
    "report_id",
    "diagnostic_session",
    "client_id",
    "kind",
    "consent",
    "comment",
    "build",
    "role",
    "peer_slot",
    "elapsed_ms",
    "dropped_events",
    "events"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/DooDesch/Support/blob/main/api/diagnostics/1.json"
}
